<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Biblioteca FALSA de ejemplo para probar el extractor del catálogo sin las DLL de Autodesk (que nunca entran en
    el repositorio). Imita a pequeña escala la forma de la API de Civil 3D: clases con propiedades, métodos, un
    método estático de creación, un enum y un miembro marcado [Obsolete]. Genera también el .xml de documentación
    para probar la lectura de los <summary>. No tiene ningún uso fuera de ArbaMcp.Pruebas.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>ExtractorCatalogo.Ejemplo</AssemblyName>
    <RootNamespace>Ejemplo</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
